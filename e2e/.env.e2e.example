# Entorno de PRUEBAS E2E (plantilla)
# Copiar a .env.e2e antes de correr `npm test`.

# Base de datos de E2E. Debe ser DIFERENTE a dev e integración.
# Setup previo (una sola vez):
#   docker exec brisee-bake-postgres psql -U brisee -d brisee_bake \
#     -c "CREATE DATABASE brisee_bake_e2e;"
DATABASE_URL="postgresql://brisee:brisee_dev@localhost:5432/brisee_bake_e2e"

# Secreto JWT para los tests. Debe coincidir con el que use el backend
# que levanta Playwright en modo E2E (ver playwright.config.ts).
JWT_SECRET="e2e-secret-brisee-playwright"

# Puertos (distintos a los de dev: 3000/3001 → 3010/3011)
# Así podés dejar los containers de dev corriendo mientras corres E2E.
BACKEND_PORT=3011
FRONTEND_PORT=3010

# URL del frontend que verá el backend (para armar los redirect-url de Wompi)
FRONTEND_URL="http://localhost:3010"

# URL del backend que verá el frontend
NEXT_PUBLIC_API_URL="http://localhost:3011"

# Config Wompi (NO se usa realmente — Playwright intercepta las llamadas)
WOMPI_PUBLIC_KEY="pub_test_e2e"
WOMPI_PRIVATE_KEY="prv_test_e2e"
WOMPI_EVENTS_SECRET="test_events_e2e"
WOMPI_INTEGRITY_SECRET="test_integrity_e2e"

# Config Email (NO se envía nada — también se mockea)
ADMIN_EMAIL="admin-e2e@briseebake.com"
EMAIL_USER="e2e-user@gmail.com"
EMAIL_PASS="e2e-password"
