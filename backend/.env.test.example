# Entorno de PRUEBAS DE INTEGRACIÓN (plantilla)
# Copiar a .env.test antes de correr `npm run test:integration`.

# Base de datos de pruebas. Debe ser una BD DIFERENTE a la de desarrollo.
# Setup previo (una sola vez):
#   docker exec brisee-bake-postgres psql -U brisee -d brisee_bake \
#     -c "CREATE DATABASE brisee_bake_test;"
DATABASE_URL="postgresql://brisee:brisee_dev@localhost:5432/brisee_bake_test"

JWT_SECRET="test-secret-brisee-integration"

WOMPI_PUBLIC_KEY="pub_test_integration"
WOMPI_PRIVATE_KEY="prv_test_integration"
WOMPI_EVENTS_SECRET="test_events_integration"
WOMPI_INTEGRITY_SECRET="test_integrity_integration"
FRONTEND_URL="http://localhost:3000"
BACKEND_PORT=3001

ADMIN_EMAIL="admin-test@briseebake.com"
EMAIL_USER="test-user@gmail.com"
EMAIL_PASS="test-password"
